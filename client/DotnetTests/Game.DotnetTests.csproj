<Project Sdk="Microsoft.NET.Sdk">
  <!--
    在 .NET 8 上驗證 Unity 專案中的純 C# 原始碼（Domain / Core / Tests）。
    LangVersion 固定為 9.0，模擬 Unity 的 C# 版本限制；原始碼以連結方式編譯，不複製。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Assets/Game/Domain/**/*.cs" />
    <Compile Include="../Assets/Game/Core/**/*.cs" />
    <Compile Include="../Assets/Game/Tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>
</Project>
